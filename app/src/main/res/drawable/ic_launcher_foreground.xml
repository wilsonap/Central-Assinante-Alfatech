    <path
        android:pathData="M20,50 C20,70.5 34.3,87 52,87 C69.7,87 84,70.5 84,50 C84,43 81.5,35.5 76,29 L70.5,33.5 C74.5,38.5 76.5,44 76.5,49.5 C76.5,65 65.5,77.5 52,77.5 C38.5,77.5 27.5,65 27.5,49.5 C27.5,43.5 29.8,38 34,33.2 L28.2,28.8 C23,34.5 20,42 20,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="87"
                android:endX="80"
                android:endY="30"
                android:type="linear">
