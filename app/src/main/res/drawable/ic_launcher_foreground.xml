                <item android:offset="0.5" android:color="#3F444D" />
                <item android:offset="1.0" android:color="#4F5560" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Arrowhead at Top Right -->
    <path
        android:pathData="M67,24.5 L86,18 L80.5,37 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="67"
                android:startY="37"
                android:endX="86"
                android:endY="18"
                android:type="linear">
                <item android:offset="0.0" android:color="#363B43" />
                <item android:offset="1.0" android:color="#202328" />
