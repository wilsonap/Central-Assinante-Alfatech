                android:startX="22"
                android:startY="50"
                android:endX="75"
                android:endY="22"
                android:type="linear">
                <item android:offset="0.0" android:color="#0063A5" />
                <item android:offset="0.5" android:color="#008BC9" />
                <item android:offset="1.0" android:color="#00A2E8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. GLOBE GRID LINES (WHITE) -->
    <!-- Center Meridian Line -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:pathData="M52,21 Q52,36 52,50.8" />
    <!-- Left Meridian 1 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M52,21 Q41,33 37,49" />
    <!-- Left Meridian 2 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:pathData="M52,21 Q30,32 24.5,48.2" />
    <!-- Right Meridian 1 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M52,21 Q63,33 67,50" />
    <!-- Right Meridian 2 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:pathData="M52,21 Q74,32 79.5,48.2" />

    <!-- Latitude Arcs (White) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M31,31 Q52,37 73,31" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M25,40 Q52,47 79,40" />

    <!-- White Separator Line at Globe Base -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M21,48 C29,50 40,51.5 52,51.5 C64,51.5 75,50 83,48" />

    <!-- 3. CHARCOAL SWOOSH RING (Bottom Half & Loop) -->
